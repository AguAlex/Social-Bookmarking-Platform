@model Social_Bookmarking_Platform.Models.Board

<div class="row">
    <div class="col-12">
        <h5 class="card-title" name="Name" style="font-size: 1.8rem; font-weight: bold; text-transform: uppercase; color: #343a40; text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.1);">
            @Model.Title
            @if (Model.IsPrivate)
            {
                <span class="badge bg-secondary ms-2 align-middle" style="font-size: 0.9rem;">Privat</span>
            }
            else
            {
                <span class="badge bg-success ms-2 align-middle" style="font-size: 0.9rem;">Public</span>
            }
        </h5>

        @if (ViewBag.EsteAdmin)
        {
            <p class="text-muted" style="font-size: 1rem; font-style: italic; margin-top: 10px;">
                <i class="bi bi-person-circle me-1" style="color: #007bff; font-size: 1.2rem;"></i>
                Creat de: <span style="font-weight: bold; color: #007bff;">@Model.User.UserName</span>
            </p>
        }

        <br />
        <br />
    </div>
    <br />

    @if (Model.BookmarkBoards.Count > 0)
    {
        @foreach (var bookmarkBoard in Model.BookmarkBoards)
        {
            <div class="col-12">
                <div class="card" style="width: 100%; border-radius: 10px; box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);">
                    <div class="card-body">
                        <partial name="BookmarkInfo" model="bookmarkBoard.Bookmark" />
                    </div>
                </div>
                <br /> <br />
            </div>
        }
    }
</div>

<style>
    .card-title {
        font-family: 'Arial', sans-serif;
        letter-spacing: 0.5px;
    }

    .text-muted {
        font-family: 'Roboto', sans-serif;
    }

    .card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 6px 15px rgba(0, 0, 0, 0.15);
        }

    .badge {
        border-radius: 10px;
    }
</style>
