@model Social_Bookmarking_Platform.Models.Board


<div class="row">

    <div class="col-12">

        <h5 class="card-title" name="Name">
            @Model.Title
            @if (Model.IsPrivate)
            {
                <span class="badge bg-secondary ms-2 align-middle">Privat</span>
            }
            else
            {
                <span class="badge bg-success ms-2 align-middle">Public</span>
            }
        </h5>

       

        @if (ViewBag.EsteAdmin)
        {
            <i class="bi bi-person"> Creat de: </i> @Model.User.UserName
           
        }

        <br /><br />
        Articole in colectie:
        <br /><br />

        
    </div>
    <br />

    @if(Model.BookmarkBoards.Count > 0)

    @foreach (var bookmarkBoard in Model.BookmarkBoards)
    {
        <div class="col-12">
            <div class="card" style="width: 100%;">

                <div class="card-body">

                    <partial name="BookmarkInfo" model="bookmarkBoard.Bookmark" />

                </div>
            </div>
            <br /> <br />
        </div>
    }
    
</div>