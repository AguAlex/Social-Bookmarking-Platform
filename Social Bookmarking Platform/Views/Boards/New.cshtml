@model Social_Bookmarking_Platform.Models.Board

<br />

<h2 class="mb-5 text-center">Adaugare Board</h2>

<br />

<form asp-action="New" asp-controller="Boards" method="post">

    <label asp-for="Title">Denumire colectie</label>
    <br />
    <input asp-for="Title" class="form-control" />
    <span asp-validation-for="Title" class="text-danger"></span>
    <br />
    <br />
    <div class="form-group">
        <label asp-for="IsPrivate">Private</label>
        <input asp-for="IsPrivate" type="checkbox" class="form-check-input" />
    </div>
    <br />
    <br />

    <button type="submit" class="btn btn-success">Adauga board</button>

</form>


