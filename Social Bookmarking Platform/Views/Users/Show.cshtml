@model Social_Bookmarking_Platform.Models.ApplicationUser


<div class="card mt-3" style="height:100%; width: 100%;">

    <!-- Imaginea de profil -->
    <div class="text-center p-3">
        <img src="@Model.ProfileImage" alt="User Profile Image"
             class="img-fluid rounded-circle shadow"
             style="width: 150px; height: 150px; object-fit: cover;">
    </div>

    <div class="card-body d-flex justify-content-between flex-column">
        <div>
            <p><i class="bi bi-person"> </i> UserName: @Model.UserName</p>

            <p><i class="bi bi-envelope"></i> Email utilizator: @Model.Email</p>

            @if (ViewBag.Roles.Count > 0)
            {
                <p><i class="bi bi-person"> </i> Roluri utilizator:</p>
                @foreach (var role in ViewBag.Roles)
                {
                    <span class="rounded-pill bg-dark mr-2 px-4 py-2 text-white">@role</span>
                }
            }
        </div>



        @if ((string)Model.Id != ViewBag.UserCurent.Id)
        {
            <div class="d-flex flex-row justify-content-between p-3">
                <form asp-controller="Users" asp-action="Delete" method="post" asp-route-id="@Model.Id">
                    <button type="submit" class="btn btn-danger">Sterge utilizator</button>
                </form>
            </div>
        }

    </div>
    
    <div class="row">
        <h4 class="mb-3">Board-urile utilizatorului:</h4>
        @if (ViewBag.UserBoards != null && ViewBag.UserBoards.Count > 0)
        {
            foreach (var board in ViewBag.UserBoards)
            {
                <div class="col-4 mb-4">

                    <div class="card">

                        <div class="card-body">

                            <h5 class="card-title" name="Name">@board.Title</h5>

                            
                                <div><i class="bi bi-person"> Creat de: </i> @board.User.UserName</div>
                            

                            <br />

                            <a asp-controller="Boards" asp-action="Show" asp-route-id="@board.Id" class="btn alert-success">Afisare Colectie</a>

                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <p class="text-muted">Acest utilizator nu are board-uri asociate.</p>
        }
    </div>
</div>






