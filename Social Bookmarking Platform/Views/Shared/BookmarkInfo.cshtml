@model Social_Bookmarking_Platform.Models.Bookmark

<div class="col-12 col-md-6 col-lg-4 mb-4">
    <div class="card rounded shadow h-100" style="border-radius: 15px;">
        <div class="card-title p-3 text-center bg-dark text-white">
            <h4>@Html.Raw(Model.Title)</h4>
        </div>

        <div class="card-body d-flex flex-column">
            <div class="text-center mb-3">
                <img src="@Model.Image" alt="Bookmark Image"
                     class="img-fluid rounded shadow"
                     style="width: 100%; max-width: 300px; height: 200px; object-fit: cover; border-radius: 15px;">
            </div>
            <p class="text-muted flex-grow-1">@Model.Content</p>
            <div class="d-flex justify-content-between flex-row mt-3">
                <div><i class="bi bi-globe"></i> @Model.Category.Title</div>
                <div><i class="bi bi-heart"></i> @Model.Likes</div>
                <div><i class="bi bi-person"></i> @Model.User.UserName</div>
            </div>
        </div>

        <div class="card-footer text-center">
            <a class="btn btn-outline-success" href="/Bookmarks/Show/@Model.Id">Vezi Bookmarkul</a>
        </div>
    </div>
</div>